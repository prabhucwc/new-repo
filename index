const MONTH_ORDER = ["June","July","August","Sept.","Oct.","Nov.","Dec.",
                     "Jan.","Feb.","March","April","May"];

// ===== DOM refs =====
const decadeSel = document.getElementById('decadeSelect');
const thead     = document.getElementById('thead');
const tbody     = document.getElementById('tbody');
const warn      = document.getElementById('warning');

// ===== Group years into decades by start year =====
const decades = {};
Object.keys(DATA).forEach(y => {
  const startYear = parseInt(y.split('-')[0], 10);
  const label = Math.floor(startYear / 10) * 10 + "s";
  (decades[label] ||= []).push(y);
});
const decadeLabels = Object.keys(decades).sort();
decadeLabels.forEach(d => decades[d].sort());

// Populate decade dropdown
decadeLabels.forEach(d => {
  const o = document.createElement('option');
  o.value = d; o.textContent = d;
  decadeSel.appendChild(o);
});

// ===== Render the whole decade as one table =====
function renderDecade(decade) {
  const years = decades[decade];
  thead.innerHTML = '';
  tbody.innerHTML = '';
  warn.innerHTML = '';

  // Header row: Month | 1992-93 | 1993-94 | ...
  const headRow = document.createElement('tr');
  const corner = document.createElement('th');
  corner.className = 'rowhead';
  corner.textContent = 'Month';
  headRow.appendChild(corner);
  years.forEach(y => {
    const th = document.createElement('th');
    th.textContent = y;
    headRow.appendChild(th);
  });
  thead.appendChild(headRow);

  // Month rows
  MONTH_ORDER.forEach(month => {
    const tr = document.createElement('tr');
    const rh = document.createElement('td');
    rh.className = 'rowhead';
    rh.textContent = month;
    tr.appendChild(rh);

    years.forEach(y => {
      const val = DATA[y][month];
      const td = document.createElement('td');
      if (val === undefined) {
        td.textContent = '—';
        td.className = 'partial';
      } else {
        td.textContent = val.toFixed(3);
      }
      tr.appendChild(td);
    });
    tbody.appendChild(tr);
  });

  // Annual total row
  const totalTr = document.createElement('tr');
  totalTr.className = 'total';
  const totalHead = document.createElement('td');
  totalHead.className = 'rowhead';
  totalHead.textContent = 'Annual total';
  totalTr.appendChild(totalHead);

  let anyIncomplete = false;
  years.forEach(y => {
    const m = DATA[y];
    const complete = Object.keys(m).length === 12;
    const sum = Object.values(m).reduce((a,b) => a + b, 0);
    const td = document.createElement('td');
    td.textContent = complete ? sum.toFixed(3) : sum.toFixed(3) + ' *';
    if (!complete) { td.classList.add('partial'); anyIncomplete = true; }
    totalTr.appendChild(td);
  });
  tbody.appendChild(totalTr);

  if (anyIncomplete) {
    warn.innerHTML = `<div class="warn">⚠️ Years marked with <b>*</b> are
      incomplete (some months missing). Their totals are partial sums, not
      full-year annual flow.</div>`;
  }
}

// ===== Sync URL hash =====
function setHash(decade) {
  history.replaceState(null, '', '#' + decade);
}

// ===== Events =====
decadeSel.addEventListener('change', () => {
  renderDecade(decadeSel.value);
  setHash(decadeSel.value);
});

// ===== Initial load =====
const fromHash = location.hash.replace('#','');
const initialDecade = decadeLabels.includes(fromHash)
  ? fromHash
  : decadeLabels[decadeLabels.length - 1];   // newest decade default
decadeSel.value = initialDecade;
renderDecade(initialDecade);
setHash(initialDecade);

window.addEventListener('hashchange', () => {
  const d = location.hash.replace('#','');
  if (!decadeLabels.includes(d)) return;
  decadeSel.value = d;
  renderDecade(d);
});
